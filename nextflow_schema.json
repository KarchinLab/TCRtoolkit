    "make_umap_if_missing": {
      "type": "boolean",
      "default": true
    },
    "umap_dims_max": {
      "type": "integer",
      "default": 30
    },
    "umap_nfeatures": {
      "type": "integer",
      "default": 3000
    },
    "raster_large_umap": {
      "type": "boolean",
      "default": true
    },
    "min_clone_size_plot": {
      "type": "integer",
      "default": 2
    },
    "top_n_clones_umap": {
      "type": "integer",
      "default": 12
    },
    "top_n_clone_table": {
      "type": "integer",
