    "vdj_meta_sample_col": {
      "type": "string",
      "default": "sample"
    },
    "vdj_meta_patient_col": {
      "type": "string",
      "default": "patient_id"
    },
    "cells_mode": {
      "type": "string",
      "default": "T-AB"
    },
    "filter_to_t_ab": {
      "type": "boolean",
      "default": true
    },
    "clone_call_preference": {
      "type": "string",
      "default": "aa"
    },
    "keep_na_clonotypes": {
      "type": "boolean"
    },
    "harmonize_apply_to": {
      "type": "string",
      "default": "tcr"
    },
    "harmonization_overlap_threshold": {
