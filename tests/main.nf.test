nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Minimal example dataset") {

        tag "basic-sd"

        when {
            params {
                samplesheet = "../../../tests/test_data/minimal-example/samplesheet.csv"
                outdir = "out-minimal-example" 
                input_format = "adaptive" 
                max_memory = "8.GB" 
                max_cpus = 4
            }
        }

        then {
            assert workflow.success
        }

    }

        test("Sc pseudobulk dataset") {

        tag "pseudobulk"

        when {
            params {
                samplesheet = "../../../tests/test_data/sc_test_data/samplesheets/samplesheet_P001_P002.csv"
                outdir = "out-sc-pseudobulk"
                max_memory = "8.GB" 
                max_cpus = 4
            }
        }

        then {
            assert workflow.success
        }

    }
}
