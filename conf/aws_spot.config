/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AWS Batch on Spot instances (-profile aws_spot)

    Fill in the queue and region, keep the work directory on S3 and always pass -resume:

        nextflow run main.nf -profile aws_spot \
            -w s3://<bucket>/tcrtoolkit-work -resume \
            --outdir s3://<bucket>/tcrtoolkit-out ...

    Resume rests on stable task hashes: the per-patient steps (TCRDIST3_MATRIX, GIANA,
    GLIPH2, PATIENT_CONCATENATE) hash only that patient's inputs, so completed patients are
    never recomputed, and the all-patient steps collect their inputs sorted so the order
    patients finished in does not change their hash.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'awsbatch'
    queue    = params.aws_queue ?: 'REPLACE_WITH_SPOT_QUEUE'

    // A reclaimed instance surfaces as a task failure; Nextflow retries it itself
    // (aws.batch.maxSpotAttempts) before this strategy sees it. Out-of-memory kills
    // (137/139/140/143) retry with the attempt-scaled memory of the base config.
    errorStrategy = { task.exitStatus in ((130..145) + [104]) ? 'retry' : 'finish' }
    maxRetries    = 3
}

aws {
    region = params.aws_region ?: 'us-east-1'
    batch {
        maxSpotAttempts = 3
        // Large Seurat / matrix staging is the slowest part of a Spot task.
        maxParallelTransfers = 8
        maxTransferAttempts  = 3
    }
    client {
        maxConnections = 32
    }
}
