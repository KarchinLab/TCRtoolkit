        patient_merge -->|bulk,sc_vdj,sc_full| tcrdist3
        tcrdist3 -->|bulk,sc_vdj,sc_full| giana
        giana -->|bulk,sc_vdj,sc_full| gliph2
    end

    subgraph cohort_level [Cohort level]
        tcrsharing[TCR sharing]
        clonal_dynamics[Clonal dynamics]

        tcrsharing -->|bulk,sc_vdj,sc_full| clonal_dynamics
    end

    subgraph downstream [Clonotype clustering & reporting]
        _join[ ]
        notebooks[Report notebooks]
        notebooks_out[ ]
        bulk_to_export[Clonotype export]
        cluster_to_sc[Clusters to cells]
