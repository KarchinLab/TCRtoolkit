    olga -->|bulk,sc_vdj,sc_full| tcrsharing
    vdjdb -->|bulk,sc_vdj,sc_full| _join
    gliph2 -->|bulk,sc_vdj,sc_full| _join
    clonal_dynamics -->|bulk,sc_vdj,sc_full| _join
