        sort_cdr3 -->|bulk,sc_vdj,sc_full| dedup
        dedup -->|bulk,sc_vdj,sc_full| olga
    end

    subgraph sample_level [Sample level]
        sample_calc[V/J usage]
        rep_metrics[Repertoire metrics]
        convergence[Convergence]
        tcrpheno[TCRpheno]
